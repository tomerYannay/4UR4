# Local Claude Code settings (machine-specific, not part of the operating system)
.claude/settings.local.json

# OS / editor cruft
.DS_Store
*.swp

# Vendor API responses and normalized caches — NEVER committed.
# Alpha Vantage ToS is personal/non-commercial by default (see
# product/data-provider-findings.md §E); committed vendor payloads would also
# make the repository a redistribution surface. HD-26 forbids both.
.cache/
*.env
.secrets/
